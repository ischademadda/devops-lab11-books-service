    {
      "name": "Конфликт ISBN (409)",
      "item": [
        {
          "name": "1. POST — создать с ISBN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Идиот\",\n  \"author\": \"Фёдор Достоевский\",\n  \"year\": 1869,\n  \"isbn\": \"{{isbn2}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"isbn2\", \"978-\" + Math.floor(1e9 + Math.random() * 9e9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"dupId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. POST — тот же ISBN (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Дубль\",\n  \"author\": \"Другой\",\n  \"year\": 2000,\n  \"isbn\": \"{{isbn2}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Есть поле error\", () => pm.expect(pm.response.json()).to.have.property(\"error\"));"
                ]
              }
            }
          ]
